# ChessArena configuration (section 6).
# Installed by bootstrap to /etc/chessarena/chessarena.env.
# The systemd units load this file; every value is a plain KEY=VALUE line.

# Database (SQLite WAL is enabled automatically by the app).
ARENA_DB_URL=sqlite:////var/lib/chessarena/arena.db

# Directory layout.
ARENA_RUN_ROOT=/var/lib/chessarena/runs
ARENA_BUILD_ROOT=/opt/chessarena/builds
ARENA_OPENING_ROOT=/opt/chessarena/openings

# Cutechess binary (v1 pins one path; the API never accepts custom args).
ARENA_CUTECHESS=/usr/bin/cutechess-cli

# Fixed production constraints (do not change without re-reviewing the spec).
ARENA_MAX_CONCURRENCY=1
ARENA_HASH_MB=32
ARENA_THREADS=1

# URL layout behind the reverse proxy.
ARENA_BASE_PATH=/chessarena
ARENA_PUBLIC_URL=https://pearllover.site/chessarena

# Worker timing.
ARENA_WORKER_POLL_SECONDS=2
ARENA_WORKER_HEARTBEAT_SECONDS=2
ARENA_WORKER_STALE_SECONDS=15
ARENA_SHUTDOWN_GRACE_SECONDS=15

ARENA_LOG_LEVEL=INFO

# Human vs Engine play (dark launch). Keep OFF until the release is deployed,
# migration 0010 has run and a server-side smoke passed; then flip to true
# and restart BOTH api and worker.
ARENA_HUMAN_PLAY_ENABLED=false

# Explicit opponent allowlist — the ONLY engines anonymous visitors may face.
# preset:<preset_id> freezes that preset; channel:<channel_id> is dereferenced
# to its EngineVersion at game creation and frozen for that game.
ARENA_HUMAN_PLAY_OPPONENTS=preset:stockfish-limited-1800,preset:stockfish-limited-2000,preset:stockfish-limited-2200,preset:stockfish-limited-2400,channel:current-final

# Fixed engine move budget (ms, server-side only; clients cannot raise it).
ARENA_HUMAN_PLAY_MOVETIME_MS=1000

# Abuse guardrails for the anonymous surface.
ARENA_HUMAN_PLAY_MAX_ACTIVE_PER_IP=2
ARENA_HUMAN_PLAY_MAX_CREATED_PER_HOUR=5
ARENA_HUMAN_PLAY_MAX_TOTAL_ACTIVE=8
ARENA_HUMAN_PLAY_TTL_SECONDS=86400
ARENA_HUMAN_PLAY_IDLE_SECONDS=3600
ARENA_HUMAN_PLAY_POLL_SECONDS=0.4
